<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/main_bg" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <!-- ================= HEADER ================= -->
        <View
            android:id="@+id/headerTile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_logo_tile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/auto_cut"
            app:layout_constraintBottom_toBottomOf="@id/headerTile"
            app:layout_constraintEnd_toEndOf="@id/headerTile"
            app:layout_constraintStart_toStartOf="@id/headerTile"
            app:layout_constraintTop_toTopOf="@id/headerTile" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:letterSpacing="0.01"
            android:text="@string/header_title"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/headerTile"
            app:layout_constraintStart_toEndOf="@id/headerTile"
            app:layout_constraintTop_toTopOf="@id/headerTile" />

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/menu_desc"
            android:src="@drawable/ic_overflow"
            app:layout_constraintBottom_toBottomOf="@id/headerTile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/headerTile" />

        <!-- ================= HERO ================= -->
        <View
            android:id="@+id/heroGlow"
            android:layout_width="212dp"
            android:layout_height="212dp"
            android:background="@drawable/bg_glow"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroIcon"
            app:layout_constraintEnd_toEndOf="@id/ivHeroIcon"
            app:layout_constraintStart_toStartOf="@id/ivHeroIcon"
            app:layout_constraintTop_toTopOf="@id/ivHeroIcon" />

        <ImageView
            android:id="@+id/ivHeroIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/auto_cut"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerTile" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.01"
            android:text="@string/hero_title"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivHeroIcon" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hero_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- ================= PRIMARY BUTTON ================= -->
        <LinearLayout
            android:id="@+id/btnOpenVideo"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <ImageView
                android:id="@+id/ivBtnBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="@null"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_video" />

            <View
                android:id="@+id/btnDivider"
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:background="#70FFFFFF" />

            <TextView
                android:id="@+id/tvOpenVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/open_video"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= SECONDARY BUTTON ================= -->
        <LinearLayout
            android:id="@+id/btnRecentFiles"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnOpenVideo">

            <ImageView
                android:id="@+id/ivClock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock" />

            <TextView
                android:id="@+id/tvRecentFiles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/recent_files"
                android:textColor="@color/text_on_dark"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- ================= EMPTY STATE ================= -->
        <LinearLayout
            android:id="@+id/cardEmpty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/navDivider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRecentFiles">

            <ImageView
                android:id="@+id/ivClapper"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clapper" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/no_recent_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/no_recent_desc"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ================= BOTTOM NAV ================= -->
        <View
            android:id="@+id/navDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/stroke_15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/bottomNav" />

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="74dp"
            android:background="@color/nav_bg"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navEdit"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavEdit"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/nav_edit"
                    android:src="@drawable/ic_scissors" />

                <TextView
                    android:id="@+id/tvNavEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/nav_edit"
                    android:textColor="@color/nav_inactive"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavSettings"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/nav_settings"
                    android:textColor="@color/nav_inactive"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
